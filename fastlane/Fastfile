# Fastfile for Nordic Asset Suite automated TestFlight deployment

default_platform(:ios)

platform :ios do
  desc "Build and upload all 4 applications to Apple TestFlight"
  lane :deploy_all do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    team_id = ENV["APPLE_TEAM_ID"]

    if key_id.to_s.empty? || issuer_id.to_s.empty? || key_content.to_s.empty?
      UI.user_error!("App Store Connect API credentials missing in environment variables.")
    end

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false,
      in_house: false
    )

    apps = [
      { name: "ApplianceWarrantyManager", scheme: "ApplianceWarrantyManager", bundle_id: "com.nordicassetsuite.appliance" },
      { name: "SkiGearTracker", scheme: "SkiGearTracker", bundle_id: "com.nordicassetsuite.skigear" },
      { name: "EBikeServiceTracker", scheme: "EBikeServiceTracker", bundle_id: "com.nordicassetsuite.ebike" },
      { name: "CoffeeMachineCompanion", scheme: "CoffeeMachineCompanion", bundle_id: "com.nordicassetsuite.coffee" }
    ]

    apps.each do |app|
      UI.header("Deploying #{app[:name]} (#{app[:bundle_id]}) to TestFlight")

      # Download or generate App Store Provisioning Profile automatically via Connect API
      begin
        get_provisioning_profile(
          api_key: api_key,
          app_identifier: app[:bundle_id],
          team_id: team_id,
          adhoc: false
        )
      rescue => e
        UI.message("Automatic profile fetch note: #{e.message}")
      end
      
      build_app(
        project: "NordicAssetSuite.xcodeproj",
        scheme: app[:scheme],
        output_directory: "build/ipa",
        output_name: "#{app[:name]}.ipa",
        export_method: "app-store",
        export_team_id: team_id,
        xcargs: (team_id && !team_id.empty?) ? "DEVELOPMENT_TEAM=#{team_id}" : nil,
        export_xcargs: "-allowProvisioningUpdates",
        skip_package_dependencies_resolution: false,
        clean: true,
        export_options: {
          method: "app-store",
          signingStyle: "automatic",
          manageAppVersionAndBuildNumber: true,
          teamID: team_id
        }
      )

      upload_to_testflight(
        api_key: api_key,
        app_identifier: app[:bundle_id],
        ipa: "build/ipa/#{app[:name]}.ipa",
        skip_waiting_for_build_processing: true
      )
      
      UI.success("Successfully uploaded #{app[:name]} to TestFlight!")
    end
  end
end
