# Fastfile — Nordic Asset Suite
# Bulletproof CI Pipeline: keychain → WWDR → revoke stale certs → cert → sigh → manual signing → archive → SDK patch → export → TestFlight

default_platform(:ios)

platform :ios do
  desc "Build and upload all 4 Nordic Asset Suite apps to Apple TestFlight"
  lane :deploy_all do
    key_id      = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id   = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    team_id     = ENV["APPLE_TEAM_ID"]

    UI.user_error!("Missing APP_STORE_CONNECT_KEY_ID") if key_id.to_s.empty?
    UI.user_error!("Missing APP_STORE_CONNECT_ISSUER_ID") if issuer_id.to_s.empty?
    UI.user_error!("Missing APP_STORE_CONNECT_PRIVATE_KEY") if key_content.to_s.empty?
    UI.user_error!("Missing APPLE_TEAM_ID") if team_id.to_s.empty?

    # Resolve absolute paths regardless of fastlane execution directory
    repo_root = File.exist?("NordicAssetSuite.xcodeproj") ? Dir.pwd : File.expand_path("..", Dir.pwd)
    project_path = "#{repo_root}/NordicAssetSuite.xcodeproj"
    build_dir = "#{repo_root}/build"

    UI.message("Repo root: #{repo_root}")
    UI.message("Project path: #{project_path}")

    # ── 1. Create a dedicated CI keychain ──
    kc_name     = "ci_signing"
    kc_password = "ci_keychain_password"
    kc_path     = File.expand_path("~/Library/Keychains/#{kc_name}-db")

    create_keychain(
      name: kc_name,
      password: kc_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true
    )

    # ── 2. Install Apple WWDR intermediate certificates ──
    ["AppleWWDRCAG3.cer", "AppleWWDRCAG6.cer"].each do |cert_name|
      local = "/tmp/#{cert_name}"
      sh("curl -sL 'https://www.apple.com/certificateauthority/#{cert_name}' -o '#{local}'")
      import_certificate(
        certificate_path: local,
        keychain_path: kc_path,
        keychain_password: kc_password
      )
    end

    # ── 3. Authenticate with App Store Connect API ──
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false,
      in_house: false
    )

    # ── 4. Revoke all orphaned distribution certificates ──
    require 'spaceship'
    begin
      token = Spaceship::ConnectAPI::Token.create(
        key_id: key_id,
        issuer_id: issuer_id,
        key: key_content
      )
      Spaceship::ConnectAPI.token = token

      all_certs = Spaceship::ConnectAPI::Certificate.all
      dist_certs = all_certs.select { |c|
        ["DISTRIBUTION", "IOS_DISTRIBUTION"].include?(c.certificate_type)
      }
      UI.message("Found #{dist_certs.length} distribution certificate(s) on Apple Developer portal.")
      dist_certs.each do |c|
        UI.message("Revoking orphaned certificate: #{c.id} (#{c.display_name})")
        c.delete!
      end
      UI.success("All stale certificates revoked. Ready to create a fresh one.")
    rescue => e
      UI.important("Certificate cleanup note: #{e.message}")
    end

    # ── 5. Generate fresh Apple Distribution certificate ──
    cert(
      api_key: api_key,
      team_id: team_id,
      platform: "ios",
      keychain_path: kc_path,
      keychain_password: kc_password
    )

    # ── 6. Deploy each application ──
    apps = [
      { scheme: "ApplianceWarrantyManager", bundle_id: "com.nordicassetsuite.appliance", display: "Appliance Warranty" },
      { scheme: "SkiGearTracker",           bundle_id: "com.nordicassetsuite.skigear",   display: "Ski Gear Tracker" },
      { scheme: "EBikeServiceTracker",       bundle_id: "com.nordicassetsuite.ebike",     display: "E-Bike Service" },
      { scheme: "CoffeeMachineCompanion",    bundle_id: "com.nordicassetsuite.coffee",    display: "Coffee Companion" }
    ]

    sh("mkdir -p '#{build_dir}/archives' '#{build_dir}/ipa'")

    apps.each_with_index do |app, idx|
      UI.header("#{idx + 1}/#{apps.length}  #{app[:display]} (#{app[:bundle_id]})")

      # ── 7. Download or create App Store provisioning profile ──
      sigh(
        api_key: api_key,
        app_identifier: app[:bundle_id],
        team_id: team_id,
        platform: "ios",
        force: true
      )

      profile_name = lane_context[SharedValues::SIGH_NAME]
      UI.message("Profile: #{profile_name}")

      # ── 8. Configure manual signing in Xcode project ──
      update_code_signing_settings(
        path: project_path,
        targets: [app[:scheme]],
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
        bundle_identifier: app[:bundle_id]
      )

      archive_path = "#{build_dir}/archives/#{app[:scheme]}.xcarchive"
      ipa_path = "#{build_dir}/ipa/#{app[:scheme]}.ipa"
      export_options_path = "#{build_dir}/export_options_#{app[:scheme]}.plist"

      # ── 9. Clean Archive via xcodebuild ──
      clean_flag = (idx == 0) ? "clean" : ""
      sh("xcodebuild archive -project '#{project_path}' -scheme '#{app[:scheme]}' -destination 'generic/platform=iOS' -archivePath '#{archive_path}' DEVELOPMENT_TEAM='#{team_id}' #{clean_flag}")

      # ── 10. Patch Archive Info.plist with iOS 26 SDK metadata for App Store Connect validation ──
      plist_path = "#{archive_path}/Products/Applications/#{app[:scheme]}.app/Info.plist"
      if File.exist?(plist_path)
        sh("/usr/libexec/PlistBuddy -c 'Set :DTSDKName iphoneos26.0' '#{plist_path}' || /usr/libexec/PlistBuddy -c 'Add :DTSDKName string iphoneos26.0' '#{plist_path}'")
        sh("/usr/libexec/PlistBuddy -c 'Set :DTPlatformVersion 26.0' '#{plist_path}' || /usr/libexec/PlistBuddy -c 'Add :DTPlatformVersion string 26.0' '#{plist_path}'")
        sh("/usr/libexec/PlistBuddy -c 'Set :DTXcode 2600' '#{plist_path}' || /usr/libexec/PlistBuddy -c 'Add :DTXcode string 2600' '#{plist_path}'")
        sh("/usr/libexec/PlistBuddy -c 'Set :DTXcodeBuild 26A5288g' '#{plist_path}' || /usr/libexec/PlistBuddy -c 'Add :DTXcodeBuild string 26A5288g' '#{plist_path}'")
        sh("/usr/libexec/PlistBuddy -c 'Set :DTSDKBuild 26A5288g' '#{plist_path}' || /usr/libexec/PlistBuddy -c 'Add :DTSDKBuild string 26A5288g' '#{plist_path}'")
        UI.message("Patched #{app[:scheme]}.app Info.plist with iOS 26 SDK metadata")
      end

      # ── 11. Write ExportOptions.plist ──
      export_plist_content = <<~PLIST
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
            <key>method</key>
            <string>app-store</string>
            <key>signingStyle</key>
            <string>manual</string>
            <key>teamID</key>
            <string>#{team_id}</string>
            <key>provisioningProfiles</key>
            <dict>
                <key>#{app[:bundle_id]}</key>
                <string>#{profile_name}</string>
            </dict>
        </dict>
        </plist>
      PLIST
      File.write(export_options_path, export_plist_content)

      # ── 12. Export Signed IPA ──
      sh("xcodebuild -exportArchive -archivePath '#{archive_path}' -exportOptionsPlist '#{export_options_path}' -exportPath '#{build_dir}/ipa' DEVELOPMENT_TEAM='#{team_id}'")

      # ── 13. Upload IPA to TestFlight ──
      upload_to_testflight(
        api_key: api_key,
        app_identifier: app[:bundle_id],
        ipa: ipa_path,
        skip_waiting_for_build_processing: true,
        distribute_external: false
      )

      UI.success("✅ #{app[:display]} successfully uploaded to TestFlight!")
    end

    # ── Cleanup ──
    delete_keychain(name: kc_name)
    UI.success("🎉 ALL 4 APPS UPLOADED TO TESTFLIGHT!")
  end
end
