# Fastfile — Nordic Asset Suite
# CI Pipeline: keychain → WWDR → revoke stale certs → cert → sigh → manual signing → build → upload

default_platform(:ios)

platform :ios do
  desc "Build and upload all 4 Nordic Asset Suite apps to Apple TestFlight"
  lane :deploy_all do
    key_id      = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id   = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    team_id     = ENV["APPLE_TEAM_ID"]

    UI.user_error!("Missing APP_STORE_CONNECT_KEY_ID") if key_id.to_s.empty?
    UI.user_error!("Missing APP_STORE_CONNECT_ISSUER_ID") if issuer_id.to_s.empty?
    UI.user_error!("Missing APP_STORE_CONNECT_PRIVATE_KEY") if key_content.to_s.empty?
    UI.user_error!("Missing APPLE_TEAM_ID") if team_id.to_s.empty?

    # ── 1. Create a dedicated CI keychain ──
    kc_name     = "ci_signing"
    kc_password = "ci_keychain_password"
    kc_path     = File.expand_path("~/Library/Keychains/#{kc_name}-db")

    create_keychain(
      name: kc_name,
      password: kc_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true
    )

    # ── 2. Install Apple WWDR intermediate certificates ──
    ["AppleWWDRCAG3.cer", "AppleWWDRCAG6.cer"].each do |cert_name|
      local = "/tmp/#{cert_name}"
      sh("curl -sL 'https://www.apple.com/certificateauthority/#{cert_name}' -o '#{local}'")
      import_certificate(
        certificate_path: local,
        keychain_path: kc_path,
        keychain_password: kc_password
      )
    end

    # ── 3. Authenticate with App Store Connect API ──
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false,
      in_house: false
    )

    # ── 4. Revoke all orphaned distribution certificates ──
    # Previous CI runs created certs whose private keys are lost.
    # Apple allows max 3 distribution certs. We must clear them first.
    require 'spaceship'
    begin
      token = Spaceship::ConnectAPI::Token.create(
        key_id: key_id,
        issuer_id: issuer_id,
        key: key_content
      )
      Spaceship::ConnectAPI.token = token

      all_certs = Spaceship::ConnectAPI::Certificate.all
      dist_certs = all_certs.select { |c|
        ["DISTRIBUTION", "IOS_DISTRIBUTION"].include?(c.certificate_type)
      }
      UI.message("Found #{dist_certs.length} distribution certificate(s) on Apple Developer portal.")
      dist_certs.each do |c|
        UI.message("Revoking orphaned certificate: #{c.id} (#{c.display_name})")
        c.delete!
      end
      UI.success("All stale certificates revoked. Ready to create a fresh one.")
    rescue => e
      UI.important("Certificate cleanup note: #{e.message}")
    end

    # ── 5. Generate fresh Apple Distribution certificate ──
    cert(
      api_key: api_key,
      team_id: team_id,
      platform: "ios",
      keychain_path: kc_path,
      keychain_password: kc_password
    )

    # ── 6. Deploy each application ──
    apps = [
      { scheme: "ApplianceWarrantyManager", bundle_id: "com.nordicassetsuite.appliance", display: "Appliance Warranty" },
      { scheme: "SkiGearTracker",           bundle_id: "com.nordicassetsuite.skigear",   display: "Ski Gear Tracker" },
      { scheme: "EBikeServiceTracker",       bundle_id: "com.nordicassetsuite.ebike",     display: "E-Bike Service" },
      { scheme: "CoffeeMachineCompanion",    bundle_id: "com.nordicassetsuite.coffee",    display: "Coffee Companion" }
    ]

    apps.each_with_index do |app, idx|
      UI.header("#{idx + 1}/#{apps.length}  #{app[:display]} (#{app[:bundle_id]})")

      # ── 7. Download or create App Store provisioning profile ──
      sigh(
        api_key: api_key,
        app_identifier: app[:bundle_id],
        team_id: team_id,
        platform: "ios",
        force: true
      )

      profile_name = lane_context[SharedValues::SIGH_NAME]
      UI.message("Profile: #{profile_name}")

      # ── 8. Configure manual signing in Xcode project ──
      update_code_signing_settings(
        path: "NordicAssetSuite.xcodeproj",
        targets: [app[:scheme]],
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
        bundle_identifier: app[:bundle_id]
      )

      # ── 9. Archive and create signed IPA ──
      build_app(
        project: "NordicAssetSuite.xcodeproj",
        scheme: app[:scheme],
        output_directory: "build/ipa",
        output_name: "#{app[:scheme]}.ipa",
        clean: (idx == 0),
        export_method: "app-store",
        export_team_id: team_id,
        xcargs: "DEVELOPMENT_TEAM='#{team_id}'",
        export_options: {
          method: "app-store",
          signingStyle: "manual",
          teamID: team_id,
          provisioningProfiles: {
            app[:bundle_id] => profile_name
          }
        }
      )

      # ── 10. Upload IPA to TestFlight ──
      upload_to_testflight(
        api_key: api_key,
        app_identifier: app[:bundle_id],
        ipa: "build/ipa/#{app[:scheme]}.ipa",
        skip_waiting_for_build_processing: true,
        distribute_external: false
      )

      UI.success("✅ #{app[:display]} uploaded to TestFlight!")
    end

    # ── Cleanup ──
    delete_keychain(name: kc_name)
    UI.success("🎉 ALL 4 APPS UPLOADED TO TESTFLIGHT!")
  end
end
