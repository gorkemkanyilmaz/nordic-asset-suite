      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Få altid dine bindinger justeret og testet af en certificeret skitekniker." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Lassen Sie Bindungen vor dem Skifahren immer von einem zertifizierten Skitechniker einstellen und prüfen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Always have bindings adjusted and tested by a certified ski technician before skiing." } },
